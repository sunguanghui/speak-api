# ==========================================
# Speak TTS API 配置文件
# ==========================================

# 1. 核心接口配置 (替换为你部署的 Cloudflare Worker 域名)
WORKER_URL=https://tts.wangwangit.com/v1/audio/speech

# 2. 存储与清理配置
# 音频存放的文件夹名称
STORAGE_DIR=mp3
# 音频保留最大时长 (3600秒 = 1小时)
MAX_AGE_SECONDS=3600

# 3. TTS 默认参数配置
# 默认发音人 (如 zh-CN-XiaoxiaoNeural, zh-CN-YunxiNeural 等)
DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
DEFAULT_SPEED=1.0
DEFAULT_PITCH=0
DEFAULT_STYLE=general
DEFAULT_VOLUME=0